{
  "name": "air-fryer-card",
  "version": "0.1.6",
  "description": "Home Assistant air fryer card with automatic capability discovery",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/core.test.ts",
    "test:browser": "playwright test",
    "check": "npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
